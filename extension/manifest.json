{
  "manifest_version": 3,
  "name": "Proxy Manager",
  "version": "2.0.0",
  "description": "浏览器代理控制扩展 — 直连本地 Clash/Mihomo，切换节点、一键测速",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://ipapi.co/*",
    "https://api.ipify.org/*",
    "https://ipwho.is/*",
    "http://ip-api.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Proxy Manager"
  },
  "options_page": "options/options.html"
}
